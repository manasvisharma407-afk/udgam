  "description": "RaahSaathi backend — realtime emergency dispatch, HerRides verification, Green Pool matching and enterprise fleet telemetry.",
  "main": "server.js",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
