# ------------------------------------------------------------------ runtime
NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# Comma-separated allowlist. *.vercel.app previews are matched automatically.
CORS_ORIGINS=http://localhost:3000,https://raahsaathi.vercel.app

# --------------------------------------------------------------- Supabase
# Project settings -> API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...        # server-only, never ship to the client
SUPABASE_JWT_SECRET=your-jwt-secret            # Project settings -> API -> JWT Secret

# Project settings -> Database -> Connection string (used by the SQL scripts)
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres

# --------------------------------------------------------------- dispatch
SOS_RADIUS_KM=5
SOS_MAX_RESPONDERS=25
LOCATION_BROADCAST_MS=3000
PRESENCE_TTL_MS=90000

# ------------------------------------------------------------- enterprise
# Shared secret for machine clients hitting /api/admin/*
ADMIN_API_KEY=change-me

# Accept unsigned demo identities. Forced off whenever NODE_ENV=production.
DEMO_MODE=true

# --------------------------------------------------------------- chatbot
# demo   = rule-based replies only, no external calls, no key needed.
# gemini / openai = the same data-grounded replies, phrased by the model.
# If the chosen provider has no key the bot falls back to demo behaviour.
AI_PROVIDER=demo
GEMINI_API_KEY=
OPENAI_API_KEY=
# Optional model overrides (defaults shown).
# GEMINI_MODEL=gemini-2.5-flash
# OPENAI_MODEL=gpt-4o-mini
